{
    "name": "phpsoftbox/resource",
    "description": "Resource component for the PhpSoftBox framework",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Anton K.",
            "email": "inspector-who@mail.ru"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "^8.5",
        "phpsoftbox/collection": "dev-master"
    },
    "require-dev": {
        "phpsoftbox/cs-fixer": "^1.2.1",
        "phpsoftbox/http-message": "dev-master",
        "phpsoftbox/orm": "dev-master",
        "phpsoftbox/pagination": "dev-master",
        "phpunit/phpunit": "^13.3"
    },
    "suggest": {
        "phpsoftbox/orm": "Provides relation load-state for whenLoaded() and requireLoaded()."
    },
    "autoload": {
        "psr-4": {
            "PhpSoftBox\\Resource\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSoftBox\\Resource\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs:fix": "vendor/bin/psb-cs-fixer fix",
        "cs:check": "vendor/bin/psb-cs-fixer check --diff"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
